class Solution {
    public int maxScore(String s) {
        int right=0,left=0,ans=0;
        for (int i=0;i<s.length();i++){
            if (s.charAt(i)=='1'){
                right++;
            }
        }
        for (int i=0;i<s.length()-1;i++){
            if (s.charAt(i)=='0'){
                left++;
            }
            if (s.charAt(i)=='1'){
                right--;
            }
            ans=Math.max(ans,left+right);
        }return ans;
    }
}
